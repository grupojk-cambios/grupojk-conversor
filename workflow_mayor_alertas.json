                                     },
                      "id":  "e3f4a5b6-0002-4d00-8d00-mayoralert002",
                      "name":  "Leer RST por Vencer",
                      "type":  "n8n-nodes-base.supabase",
                      "typeVersion":  1,
                      "position":  [
                                       176,
                                       300
                                   ],
                      "onError":  "continueRegularOutput",
                      "alwaysOutputData":  true,
                      "credentials":  {
                                          "supabaseApi":  {
                                                              "id":  "JCvvp9JkZ15OpA9E",
                                                              "name":  "Supabase Cambios JK"
                                                          }
                                      }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Casi todas las veces no hay nada por avisar: se corta aqui y no se lee nada mas.\nlet filas = [];\ntry { filas = $(\u0027Leer RST por Vencer\u0027).all().map(i =\u003e i.json).filter(r =\u003e r \u0026\u0026 r.id \u0026\u0026 !r.error); } catch(e){ filas = []; }\nreturn filas.length ? [{ json: { cuantas: filas.length } }] : [];"
                                     },
                      "id":  "e3f4a5b6-0003-4d00-8d00-mayoralert003",
                      "name":  "Hay Algo?",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       352,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "tableId":  "grupos_mayor",
                                         "filterString":  "tipo=eq.destino",
                                         "resource":  "row",
                                         "filterType":  "string",
